# Textie backend environment variables
# Copy this file to `.env` and fill in real values.

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:root@127.0.0.1:5432/textie

# Fernet 32-byte key (base64). Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CRYPT_SECRET_KEY=

# Redis coordinates WebSocket broadcasts across backend worker processes and stores shared rate limits.
REDIS_URL=redis://localhost:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Redis-shared abuse controls.
CREATE_CHAT_RATE_LIMIT=5
CREATE_CHAT_RATE_WINDOW_SECONDS=60
JOIN_RATE_LIMIT=8
JOIN_RATE_WINDOW_SECONDS=60
MESSAGE_RATE_LIMIT=30
MESSAGE_RATE_WINDOW_SECONDS=10
MAX_PARTICIPANTS_PER_CONVERSATION=2
PRESENCE_TTL_SECONDS=45
HEARTBEAT_INTERVAL_SECONDS=15
WS_SEND_QUEUE_SIZE=64
WS_SEND_TIMEOUT_SECONDS=5
CONVERSATION_TTL_HOURS=1

# Per backend worker SQLAlchemy connection pool. Total DB connections are
# approximately worker_count * (DB_POOL_SIZE + DB_MAX_OVERFLOW).
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
REDIS_MAX_CONNECTIONS=100

# Seconds an INACTIVE conversation is kept before being deleted (default 120)
# CONVERSATION_GRACE_PERIOD_SECONDS=120
